---
/* =========================================================================
   RepoModal.astro — Detalhes de um repositório em <dialog> nativo
   -------------------------------------------------------------------------
   Aberto pelos cards da seção GitHub (ver script em GitHub.astro).
   <dialog> + showModal() já dá: foco preso dentro, Esc fecha, fundo inerte.
   Conteúdo: mídia (prints próprios ou a prévia do GitHub), descrição,
   resumo (texto próprio ou trecho do README), linguagens, dados e links.
   ========================================================================= */
import type { GhRepo } from '../../lib/github';
import type { RepoExtra } from '../../data/github-extras';
import { url } from '../../lib/utils';
import Tags from './Tags.astro';

interface Props { repo: GhRepo; extra?: RepoExtra }
const { repo: r, extra } = Astro.props;

const id = `gh-${r.name}`;
const fmt = (iso: string) => new Date(iso).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
/* Galeria: sempre 3 posições. Ordem: prints próprios (até 3) → prévia do
   GitHub (se ainda não houver nenhum print) → quadros "em breve". */
const SLOTS = 3;
type Slide = { src?: string; alt: string; legenda?: string };
const own: Slide[] = (extra?.imagens ?? []).slice(0, SLOTS).map((i) => ({ ...i, src: url(i.src) }));
const slides: Slide[] = own.length ? own : [{ src: r.preview, alt: `Prévia do repositório ${r.name} no GitHub`, legenda: 'Prévia gerada pelo GitHub' }];
while (slides.length < SLOTS) slides.push({ alt: `Imagem ${slides.length + 1} em breve` });
const resumo = extra?.resumo;
---
<dialog class="repo" id={id} aria-labelledby={`${id}-t`} data-lenis-prevent>
  <div class="repo__inner">
    <header class="repo__head">
      <div>
        <p class="eyebrow">Repositório</p>
        <h3 class="repo__title" id={`${id}-t`}>{r.name}</h3>
      </div>
      <button type="button" class="repo__close" data-close aria-label="Fechar">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      </button>
    </header>

    <div class="repo__body">
      <section class="gal" aria-roledescription="carrossel" aria-label={`Imagens de ${r.name}`} data-gal>
        <div class="gal__view">
          <ul class="gal__track" data-track tabindex="0" aria-live="polite">
            {slides.map((sl, i) => (
              <li class="gal__slide" aria-roledescription="slide" aria-label={`${i + 1} de ${SLOTS}`}>
                <div class="repo__frame">
                  {sl.src ? (
                    <>
                      <img src={sl.src} alt={sl.alt} width="1200" height="600" loading="lazy" decoding="async" data-img />
                      <span class="repo__ph" aria-hidden="true">{r.name}</span>
                    </>
                  ) : (
                    <span class="repo__ph repo__ph--soon" role="img" aria-label={sl.alt}>
                      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="9" cy="10" r="1.6" fill="currentColor"/><path d="M4 17l5-5 4 4 3-3 4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                      <span>Imagem {i + 1} · em breve</span>
                    </span>
                  )}
                </div>
                {sl.legenda && <p class="gal__cap">{sl.legenda}</p>}
              </li>
            ))}
          </ul>
          <button type="button" class="gal__nav gal__nav--prev" data-prev aria-label="Imagem anterior">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="gal__nav gal__nav--next" data-next aria-label="Próxima imagem">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
        <div class="gal__bar">
          <div class="gal__dots">
            {slides.map((_, i) => (
              <button type="button" data-dot={i} aria-label={`Ir para imagem ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}></button>
            ))}
          </div>
          <span class="gal__count" data-count>1 / {SLOTS}</span>
        </div>
      </section>

      <div class="repo__info">
        <p class="repo__desc">{r.description ?? 'Sem descrição no GitHub.'}</p>

        {r.languages.length > 0 && (
          <div class="repo__langs">
            <div class="repo__bar" aria-hidden="true">
              {r.languages.map((l, i) => <span style={`flex:${l.pct};--i:${i}`}></span>)}
            </div>
            <ul>
              {r.languages.slice(0, 5).map((l, i) => <li style={`--i:${i}`}><i></i>{l.name} <span>{l.pct.toLocaleString('pt-BR')}%</span></li>)}
            </ul>
          </div>
        )}

        <dl class="repo__facts">
          <div><dt>Estrelas</dt><dd>{r.stars}</dd></div>
          <div><dt>Forks</dt><dd>{r.forks}</dd></div>
          <div><dt>Criado</dt><dd>{fmt(r.createdAt)}</dd></div>
          <div><dt>Atualizado</dt><dd>{fmt(r.pushedAt)}</dd></div>
          {r.license && <div><dt>Licença</dt><dd>{r.license}</dd></div>}
        </dl>

        {r.topics.length > 0 && <Tags items={r.topics} />}
      </div>

      {(resumo?.length || r.readme.length > 0) && (
        <section class="repo__about" aria-label="Sobre o projeto">
          <p class="sec__label">Sobre o projeto</p>
          <div class="repo__text">
            {resumo
              ? resumo.map((p) => <p>{p}</p>)
              : r.readme.filter((b) => !(b.type === 'h' && /^sobre( o projeto)?$/i.test(b.text))).map((b) => b.type === 'h' ? <h4>{b.text}</h4> : b.type === 'li' ? <p class="repo__li">{b.text}</p> : <p>{b.text}</p>)}
          </div>
          {!resumo && <p class="repo__src">Trecho do README do repositório.</p>}
        </section>
      )}
    </div>

    <footer class="repo__foot">
      {r.homepage && <a class="btn" href={r.homepage} target="_blank" rel="noopener">Ver site / demo ↗</a>}
      <a class="btn btn--solid" href={r.url} target="_blank" rel="noopener">Abrir no GitHub ↗</a>
    </footer>
  </div>
</dialog>
