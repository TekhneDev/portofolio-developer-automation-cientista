---
/* Hiring.astro — 05 · Contratação: CLT × PJ, etapas de um projeto PJ e FAQ (<details> nativo). */
import { hiring, steps, faq } from '../../data/site';
import SectionHead from '../ui/SectionHead.astro';
---
<section class="sec" id="contratacao" aria-labelledby="h-hire" data-morph="2">
  <SectionHead n="06" id="h-hire" title="Modelos de contratação"
    hint="Trabalho em regime CLT ou como PJ. Veja o que muda em cada formato." />

  <div class="hire" data-reveal-group>
    {hiring.map((h) => (
      <article class={`hire__card hire__card--${h.id}`}>
        <h3>{h.title}</h3>
        <p class="hire__for">{h.for}</p>
        <ul>{h.items.map((i) => <li>{i}</li>)}</ul>
        <p class="hire__fmt">{h.format}</p>
      </article>
    ))}
  </div>

  <h3 class="sec__label">Como um projeto PJ começa</h3>
  <ol class="steps" data-reveal-group>
    {steps.map((s, i) => (
      <li><span class="steps__n">{i + 1}</span><h4>{s.title}</h4><p>{s.text}</p></li>
    ))}
  </ol>

  <h3 class="sec__label">Perguntas frequentes</h3>
  <div class="faq">
    {faq.map((f) => (
      <details><summary>{f.q}</summary><p>{f.a}</p></details>
    ))}
  </div>
</section>
