---
/* =========================================================================
   GitHub.astro — 04 · GitHub
   Perfil e repositórios vindos direto da API do GitHub (src/lib/github.ts).
   O HTML sai pronto do build; no navegador, os números são atualizados ao
   vivo (uma chamada à API pública). Se a chamada falhar, fica o do build.
   ========================================================================= */
import { getGithub, GITHUB_USER } from '../../lib/github';
import { githubExtras } from '../../data/github-extras';
import SectionHead from '../ui/SectionHead.astro';
import RepoModal from '../ui/RepoModal.astro';

const gh = await getGithub();
const profileUrl = gh?.url ?? `https://github.com/${GITHUB_USER}`;
const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
---
<section class="sec" id="github" aria-labelledby="h-github" data-morph="1">
  <SectionHead n="04" id="h-github" title="GitHub" hint="Integrado à API do GitHub: perfil e repositórios atualizados direto da fonte." />

  {gh ? (
    <div class="gh" data-gh-user={gh.login}>
      <a class="gh__profile" href={profileUrl} target="_blank" rel="noopener">
        <img class="gh__avatar" src={gh.avatar} alt="" width="64" height="64" loading="lazy" decoding="async" />
        <span class="gh__id">
          <strong>{gh.name ?? gh.login}</strong>
          <span>@{gh.login}</span>
        </span>
        <span class="lab__go">Ver perfil</span>
      </a>

      <dl class="avail gh__stats">
        <div><dt>Repositórios</dt><dd data-gh="public_repos">{gh.publicRepos}</dd></div>
        <div><dt>Seguidores</dt><dd data-gh="followers">{gh.followers}</dd></div>
        <div><dt>Estrelas</dt><dd>{gh.stars}</dd></div>
        <div><dt>Linguagens</dt><dd>{gh.languages.map((l) => l.name).join(' · ') || '—'}</dd></div>
      </dl>

      <p class="sec__label">Atividade recente</p>
      <ul class="lab gh__repos" data-reveal-group>
        {gh.repos.map((r) => (
          <li>
            {/* Link real para o GitHub; com JS, o clique abre o modal de detalhes
                (Ctrl/⌘+clique e clique do meio continuam abrindo o GitHub). */}
            <a class="lab__item" href={r.url} target="_blank" rel="noopener" data-repo={`gh-${r.name}`} aria-haspopup="dialog">
              <h3>{r.name}</h3>
              <p>{r.description ?? 'Sem descrição.'}</p>
              <span class="gh__meta">
                {r.language && <span>{r.language}</span>}
                <span aria-label={`${r.stars} estrelas`}>★ {r.stars}</span>
                <span>atualizado {fmtDate(r.pushedAt)}</span>
              </span>
              <span class="lab__go">Ver detalhes</span>
            </a>
          </li>
        ))}
      </ul>
      {gh.repos.map((r) => <RepoModal repo={r} extra={githubExtras[r.name]} />)}
    </div>
  ) : (
    <p class="gh__fallback">
      Veja meus repositórios em <a href={profileUrl} target="_blank" rel="noopener">github.com/{GITHUB_USER}</a>.
    </p>
  )}
</section>

<script>
  /* Atualiza seguidores/repositórios ao vivo. Silencioso em caso de erro ou limite de taxa. */
  async function refresh() {
    const root = document.querySelector<HTMLElement>('[data-gh-user]');
    if (!root) return;
    try {
      const res = await fetch(`https://api.github.com/users/${root.dataset.ghUser}`, {
        headers: { Accept: 'application/vnd.github+json' },
      });
      if (!res.ok) return;
      const u = await res.json();
      root.querySelectorAll<HTMLElement>('[data-gh]').forEach((el) => {
        const v = u[el.dataset.gh!];
        if (typeof v === 'number') el.textContent = String(v);
      });
    } catch { /* mantém os números do build */ }
  }
  document.addEventListener('astro:page-load', refresh);

  /* ---------- Modal de detalhes ---------- */
  import { emit, EVT } from '../../lib/bus';

  let ctrl: AbortController | null = null;
  document.addEventListener('astro:page-load', () => {
    ctrl?.abort();
    ctrl = new AbortController();
    const { signal } = ctrl;

    document.querySelectorAll<HTMLAnchorElement>('[data-repo]').forEach((card) => {
      const dlg = document.getElementById(card.dataset.repo!) as HTMLDialogElement | null;
      if (!dlg) return;
      card.addEventListener('click', (e) => {
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return; // nova aba: deixa o link
        e.preventDefault();
        dlg.showModal();
        emit(EVT.lock, true);                    // pausa a rolagem suave da página
        document.documentElement.classList.add('modal-open');
      }, { signal });
    });

    document.querySelectorAll<HTMLDialogElement>('dialog.repo').forEach((dlg) => {
      // Imagem indisponível (ex.: prévia do GitHub com limite): mostra o quadro com o nome.
      dlg.querySelectorAll<HTMLImageElement>('[data-img]').forEach((img) => {
        const fail = () => img.classList.add('is-broken');
        img.addEventListener('error', fail, { signal });
        if (img.complete && img.naturalWidth === 0 && img.currentSrc) fail();
      });

      /* Galeria: trilho com scroll-snap (arrastar funciona nativo); setas,
         bolinhas e teclado só rolam o trilho até o slide certo. */
      const track = dlg.querySelector<HTMLElement>('[data-track]');
      const dots = [...dlg.querySelectorAll<HTMLButtonElement>('[data-dot]')];
      const count = dlg.querySelector<HTMLElement>('[data-count]');
      const prev = dlg.querySelector<HTMLButtonElement>('[data-prev]');
      const next = dlg.querySelector<HTMLButtonElement>('[data-next]');
      let cur = 0;
      const total = dots.length;
      const go = (i: number, smooth = true) => {
        if (!track) return;
        cur = (i + total) % total;               // circular: da última volta à primeira
        track.scrollTo({ left: cur * track.clientWidth, behavior: smooth ? 'smooth' : 'instant' });
      };
      const sync = () => {
        if (!track) return;
        cur = Math.round(track.scrollLeft / track.clientWidth);
        dots.forEach((d, i) => d.toggleAttribute('aria-current', i === cur));
        if (count) count.textContent = `${cur + 1} / ${total}`;
      };
      let raf = 0;
      track?.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(sync); }, { passive: true, signal });
      prev?.addEventListener('click', () => go(cur - 1), { signal });
      next?.addEventListener('click', () => go(cur + 1), { signal });
      dots.forEach((d, i) => d.addEventListener('click', () => go(i), { signal }));
      dlg.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); go(cur + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(cur - 1); }
      }, { signal });

      // Fecha no X ou clicando no fundo escurecido (fora do conteúdo).
      dlg.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t === dlg || t.closest('[data-close]')) dlg.close();
      }, { signal });
      // Sempre reabre na primeira imagem.
      dlg.addEventListener('close', () => go(0, false), { signal });
      dlg.addEventListener('close', () => {
        emit(EVT.lock, false);
        document.documentElement.classList.remove('modal-open');
      }, { signal });
    });
  });
  // Troca de página com um modal aberto: libera a rolagem.
  document.addEventListener('astro:before-swap', () => {
    document.querySelectorAll<HTMLDialogElement>('dialog.repo[open]').forEach((d) => d.close());
  });
</script>
